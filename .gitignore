# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Sources et brouillons d'images du hero : captures d'ecran, rendus
# generes, PNG lourds dont la version .webp servie existe a cote. Ils
# restent sur le disque mais n'ont rien a faire dans le depot — chaque
# clone et chaque deploiement les trimballerait pour rien.
public/images/hero/Capture*
public/images/hero/Gemini_Generated_Image_*
public/images/hero/hero-genere.jpg
public/images/hero/fruits.png
public/images/hero/mandarine-zeste.png
